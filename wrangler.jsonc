{
  "name": "fanxing-homepage",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "MY_HOME_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "routes": [
    {
      "pattern": "724520.xyz",
      "custom_domain": true
    },
    {
      "pattern": "fast.724520.xyz/*",
      "zone_name": "724520.xyz"
    }
  ]
}
